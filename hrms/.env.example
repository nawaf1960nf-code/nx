# ═══════════════════════════════════════
# إعدادات البيئة — انسخ هذا الملف إلى .env واملأ القيم
# ═══════════════════════════════════════

# قاعدة البيانات
DATABASE_URL="postgresql://hrms_user:CHANGE_ME@localhost:5432/hrms?schema=public"

# بيئة التشغيل
NODE_ENV="development"
PORT="4000"
APP_URL="http://localhost:5173"

# مفاتيح JWT
JWT_ACCESS_SECRET="CHANGE_ME_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Redis (الكاش والطوابير والإشعارات المؤجلة)
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# تخزين الملفات (MinIO / S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_BUCKET="hrms-files"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"

# الأمان
BCRYPT_SALT_ROUNDS="12"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
MAX_FAILED_LOGIN_ATTEMPTS="5"
ACCOUNT_LOCK_MINUTES="30"
